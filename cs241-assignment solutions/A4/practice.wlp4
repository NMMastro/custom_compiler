long wain (long* arr, long size) {
    long highestcount = 0;
    long highestvalue = 0;
    long* counters = NULL;

    long abshighestvalue = 0;
    long abscurrentvalue = 0;
    long tempvalue = 0;
    long tempindex = 0;

    long i = 0;

    counters = new long [483];

    while(i < 483) {
        *(counters + i) = 0;
        i = i + 1;
    }

    i = 0;

    while(i < size) {
        tempvalue = *(arr+i);
        tempindex = tempvalue + 241;
        *(counters + tempindex) = *(counters + tempindex) + 1;
        i = i + 1;
    }

    i = 0;

    while(i < 483) {
        if (*(counters + i) > highestcount) {
            highestcount = *(counters + i);
            highestvalue = i - 241;

            if (highestvalue < 0) {
                abshighestvalue = 0 - highestvalue;
            }
            else {
                abshighestvalue = highestvalue;
            }
        }
        else {
        }


        if (*(counters + i) == highestcount) {
            tempvalue = i - 241;
            if (tempvalue < 0) {
                abscurrentvalue = 0 - tempvalue;
            }
            else {
                abscurrentvalue = tempvalue;
            }

            if (abscurrentvalue > abshighestvalue) {
            }
            else {

                if (abscurrentvalue < abshighestvalue) {
                    highestcount = *(counters + i);
                    highestvalue = tempvalue;
                    abshighestvalue = abscurrentvalue;
                }
                else {

                    if (tempvalue < highestvalue) {
                        highestcount = *(counters + i);
                        highestvalue = tempvalue;
                        abshighestvalue = abscurrentvalue;
                    }
                    else {
                    }

                }

            }

        }
        else {
        }
        i = i + 1;
    }
    delete [] counters;
    return highestvalue;
}