// Big WLP4 scanner test
// This comment has symbols: ! @ # $ ^ ~ : " ' . ? and should be ignored

long helper(long x, long* arr) {
  long y = 0;
  y = x + 12 * 3 - 4 / 2 % 5;
  println(y);
  putchar(65);
  return y;
}

long getzero() {
  return getchar();
}

long wain(long* a, long b) {
  long x = 0;
  long y = 123456789;
  long* p = NULL;
  long* q = NULL;

  p = new long[b];
  q = &x;

  if (x == 0) {
    x = helper(b, p);
  } else {
    x = x + 1;
  }

  while (x <= y) {
    x = x + 1;
    y = y - 2;
  }

  if (x != y) {
    println(x);
  } else {
    println(y);
  }

  if (x < y) {
    putchar(66);
  } else {
    putchar(67);
  }

  if (x >= y) {
    x = *q;
  } else {
    x = p[0];
  }

  delete [] p;
  return x;
}
